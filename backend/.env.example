# Copy to .env (never commit .env). Every setting can also be a real environment variable.
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
# Where tokens, instruments and candles are kept (outside the repo is fine)
DATA_DIR=./data
# Secret the clients (web app, phone) send as "Authorization: Bearer <APP_SECRET>". At least 24 characters.
APP_SECRET=change-me-to-a-long-random-string
# Kite Connect app (https://developers.kite.trade). Redirect URL of the app must be http://<host>:<port>/auth/kite/callback
KITE_API_KEY=
KITE_API_SECRET=
